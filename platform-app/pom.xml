<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.algoeval</groupId>
        <artifactId>algo-eval-platform</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>platform-app</artifactId>
    <name>platform-app</name>
    <description>all-in-one 启动器：组合全部模块单 JVM 运行 + 托管静态前端（真实中间件轨道）</description>
    <dependencies>
        <dependency>
            <groupId>com.algoeval</groupId>
            <artifactId>source-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>com.algoeval</groupId>
            <artifactId>mock-source</artifactId>
        </dependency>
        <dependency>
            <groupId>com.algoeval</groupId>
            <artifactId>hq-source-jeromq</artifactId>
        </dependency>
        <dependency>
            <groupId>com.algoeval</groupId>
            <artifactId>collector-hq</artifactId>
        </dependency>
        <dependency>
            <groupId>com.algoeval</groupId>
            <artifactId>collector-trade</artifactId>
        </dependency>
        <dependency>
            <groupId>com.algoeval</groupId>
            <artifactId>trade-ingest</artifactId>
        </dependency>
        <dependency>
            <groupId>com.algoeval</groupId>
            <artifactId>data-storer</artifactId>
        </dependency>
        <dependency>
            <groupId>com.algoeval</groupId>
            <artifactId>offline-calculate</artifactId>
        </dependency>
        <dependency>
            <groupId>com.algoeval</groupId>
            <artifactId>stream-calculate</artifactId>
        </dependency>
        <dependency>
            <groupId>com.algoeval</groupId>
            <artifactId>statistic</artifactId>
        </dependency>
        <dependency>
            <groupId>com.algoeval</groupId>
            <artifactId>portrait</artifactId>
        </dependency>
        <dependency>
            <groupId>com.algoeval</groupId>
            <artifactId>recommender</artifactId>
        </dependency>
        <dependency>
            <groupId>com.algoeval</groupId>
            <artifactId>ai-insight</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <!-- Nacos 注册中心 + 配置中心（§13.6 演进决策） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

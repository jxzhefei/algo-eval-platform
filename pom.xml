<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.algoeval</groupId>
    <artifactId>algo-eval-platform</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>algo-eval-platform</name>
    <description>智能算法评价平台 - 券商私有化部署算法交易评价系统</description>

    <modules>
        <module>source-sdk</module>
        <module>mock-source</module>
        <module>hq-source-jeromq</module>
        <module>collector-hq</module>
        <module>collector-trade</module>
        <module>trade-ingest</module>
        <module>infra-core</module>
        <module>data-storer</module>
        <module>offline-calculate</module>
        <module>stream-calculate</module>
        <module>statistic</module>
        <module>portrait</module>
        <module>recommender</module>
        <module>ai-insight</module>
        <module>platform-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <disruptor.version>4.0.0</disruptor.version>
        <redisson.version>3.32.0</redisson.version>
        <seata.version>2.2.0</seata.version>
        <jeromq.version>0.6.0</jeromq.version>
        <shardingsphere.version>5.5.0</shardingsphere.version>
        <clickhouse-jdbc.version>0.6.5</clickhouse-jdbc.version>
        <caffeine.version>3.1.8</caffeine.version>
        <protobuf.version>3.25.5</protobuf.version>
        <protobuf-plugin.version>0.6.1</protobuf-plugin.version>
        <antlr4.version>4.10.1</antlr4.version>
        <spring-cloud.version>2023.0.3</spring-cloud.version>
        <spring-cloud-alibaba.version>2023.0.3.2</spring-cloud-alibaba.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.algoeval</groupId>
                <artifactId>source-sdk</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.algoeval</groupId>
                <artifactId>mock-source</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.algoeval</groupId>
                <artifactId>hq-source-jeromq</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.algoeval</groupId>
                <artifactId>collector-hq</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.algoeval</groupId>
                <artifactId>collector-trade</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.algoeval</groupId>
                <artifactId>trade-ingest</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.algoeval</groupId>
                <artifactId>infra-core</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.algoeval</groupId>
                <artifactId>data-storer</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.algoeval</groupId>
                <artifactId>offline-calculate</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.algoeval</groupId>
                <artifactId>stream-calculate</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.algoeval</groupId>
                <artifactId>statistic</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.algoeval</groupId>
                <artifactId>portrait</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.algoeval</groupId>
                <artifactId>recommender</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.algoeval</groupId>
                <artifactId>ai-insight</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>com.lmax</groupId>
                <artifactId>disruptor</artifactId>
                <version>${disruptor.version}</version>
            </dependency>
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.zeromq</groupId>
                <artifactId>jeromq</artifactId>
                <version>${jeromq.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.shardingsphere</groupId>
                <artifactId>shardingsphere-jdbc</artifactId>
                <version>${shardingsphere.version}</version>
                <!-- 5.5.0 依赖树脏依赖：test-util 为测试件，排除避免解析失败 -->
                <exclusions>
                    <exclusion>
                        <groupId>org.apache.shardingsphere</groupId>
                        <artifactId>shardingsphere-test-util</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.apache.shardingsphere</groupId>
                <artifactId>shardingsphere-infra-util</artifactId>
                <version>${shardingsphere.version}</version>
            </dependency>
            <dependency>
                <groupId>com.clickhouse</groupId>
                <artifactId>clickhouse-jdbc</artifactId>
                <version>${clickhouse-jdbc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.ben-manes.caffeine</groupId>
                <artifactId>caffeine</artifactId>
                <version>${caffeine.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
            <!-- ANTLR 版本统一：ShardingSphere 5.5 SQL 解析器需 4.10.1（ATN 序列化 v4）；
                 Seata 传递的 4.8 会被覆盖。Seata AT 启用时其自带解析器与 4.10 运行时的
                 兼容性见 §13.5（默认本地事务档位不受影响） -->
            <dependency>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-runtime</artifactId>
                <version>${antlr4.version}</version>
            </dependency>
            <dependency>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4</artifactId>
                <version>${antlr4.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
